function init(self)
	self.view = vmath.matrix4()  -- Inicializa com matriz identidade
	self.model_predicate = render.predicate({"model"})
	self.clear_color = vmath.vector4(0.1, 0.0, 0.2, 1)  -- roxo escuro
	
end

function update(self, dt)
	local w = render.get_window_width()
	local h = render.get_window_height()
	render.set_projection(vmath.matrix4_perspective(
		math.pi / 4,   -- FOV: 45 graus (era math.pi/3 = 60°)
		w / h,
		0.1,
		500            -- Far plane (era 1000)
	))	
	local cameras = camera.get_cameras()
	if #cameras > 0 then
		render.set_camera(cameras[1])
	end
	render.clear({
		[graphics.BUFFER_TYPE_COLOR0_BIT] = self.clear_color,
		[graphics.BUFFER_TYPE_DEPTH_BIT]  = 1,
	})

	render.draw(self.model_predicate)
end

